# =============================================================
# .env.dev — 로컬 개발 환경 변수
# cp .env.example .env.dev 후 이 파일 수정
#
# 사용: docker compose -f docker-compose.dev.yml up -d --build
# =============================================================

# ─────────────────────────────────────────
# PostgreSQL (로컬 개발용 — 보안 불필요)
# ─────────────────────────────────────────
DB_NAME=fourleaf_dev
DB_USER=fourleaf
DB_PASSWORD=devpassword

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=devpassword

# ─────────────────────────────────────────
# Backend (Spring Boot)
# ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fourleaf_dev
SPRING_DATASOURCE_USERNAME=fourleaf
SPRING_DATASOURCE_PASSWORD=devpassword
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=devpassword
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long

# ─────────────────────────────────────────
# AI 서비스 (실제 키 필요)
# ─────────────────────────────────────────
OPENAI_API_KEY=sk-...여기에_실제_키_입력
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=four-leaf-dev
BACKEND_BASE_URL=http://backend:8080

# ─────────────────────────────────────────
# Frontend (Vite 빌드 시 사용)
# ─────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai
