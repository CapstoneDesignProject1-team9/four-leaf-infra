# =============================================================
# .env.dev — 로컬 개발 환경 변수
# cp .env.example .env.dev 후 이 파일 수정
#
# 사용: docker compose -f docker-compose.dev.yml up -d --build
# =============================================================

# ─────────────────────────────────────────
# PostgreSQL (로컬 개발용 — 보안 불필요)
# ─────────────────────────────────────────
DB_NAME=fourleaf_dev
DB_USER=fourleaf
DB_PASSWORD=devpassword

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=devpassword

# ─────────────────────────────────────────
# Backend (Spring Boot)
# ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fourleaf_dev
SPRING_DATASOURCE_USERNAME=fourleaf
SPRING_DATASOURCE_PASSWORD=devpassword
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=devpassword
JWT_SECRET=dev-jwt-secret-key-minimum-32-characters-long

# ─────────────────────────────────────────
# AI 서비스 (실제 키 필요)
# ─────────────────────────────────────────
# Claude judge key for evaluation (required only when running eval/evaluate.py)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-opus-20240229
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=four-leaf-dev
BACKEND_BASE_URL=http://backend:8080
AI_SERVICE_URL=http://ai:8000
# Ollama runs on the host Mac, while the AI API runs in Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
VLLM_BASE_URL=http://vllm:8000
VLLM_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_LORA_ADAPTERS={"student-lora":"student-lora","professor-lora":"professor-lora"}

# ─────────────────────────────────────────
# Frontend (Vite 빌드 시 사용)
# ─────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai
