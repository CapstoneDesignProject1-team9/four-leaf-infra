# =============================================================
# .env.example — 프로덕션(EC2) 환경변수 템플릿
#   cp .env.example .env  후 값을 채우고 EC2의 ~/four-leaf-infra/.env 로 올립니다.
# 개발용은 .env.dev.example 을 쓰세요.
# =============================================================

# ─────────────────────────────────────────
# PostgreSQL
# 백엔드(SPRING_DATASOURCE_*)와 AI(DB_*) 접속 정보는 docker-compose.yml이
# 아래 세 값으로 만들어 주므로 여기에만 적으면 됩니다.
# ─────────────────────────────────────────
DB_NAME=fourleaf
DB_USER=fourleaf
DB_PASSWORD=your_strong_password_here

# ─────────────────────────────────────────
# AI 서비스: 답변 생성 (Modal의 vLLM, modal_app.py)
# ─────────────────────────────────────────
# /v1 은 붙이지 않습니다. modal deploy 출력에 나오는 URL입니다.
VLLM_BASE_URL=https://<workspace>--four-leaf-llama-llamaserver.<region>.modal.direct
# modal_app.py 의 --served-model-name / --lora-modules 이름과 같아야 합니다.
VLLM_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_LORA_ADAPTERS={"student-lora":"student-lora"}
# 요청에 model_name이 없을 때 쓸 모델. 비우면 기반 모델(RAG만)로 답합니다.
VLLM_DEFAULT_MODEL=student-lora
VLLM_MAX_TOKENS=768
# Modal Proxy Auth Token (Modal 대시보드 → Settings → Proxy Auth Tokens)
VLLM_PROXY_KEY=wk-...
VLLM_PROXY_SECRET=ws-...

# ─────────────────────────────────────────
# AI 서비스: 교수자 어드바이저 (Claude)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ADVISOR_MODEL=claude-haiku-5-5

# ─────────────────────────────────────────
# ECR 이미지 주소 (배포 워크플로가 태그를 자동으로 갱신합니다)
# ─────────────────────────────────────────
FRONTEND_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-frontend:latest
BACKEND_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-backend:latest
AI_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-ai:latest
