# =============================================================
# .env.example — 환경변수 템플릿
# 이 파일을 복사해서 .env (프로덕션) 또는 .env.dev (개발)을 만드세요
# cp .env.example .env
# =============================================================

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DB_NAME=fourleaf
DB_USER=fourleaf
DB_PASSWORD=your_strong_password_here

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here

# ─────────────────────────────────────────
# Backend (Spring Boot)
# ─────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fourleaf
SPRING_DATASOURCE_USERNAME=fourleaf
SPRING_DATASOURCE_PASSWORD=your_strong_password_here
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_redis_password_here
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# vLLM (GPU profile): LoRA adapters are mounted from their PEFT adapter directories
VLLM_BASE_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_BASE_URL=http://vllm:8000
VLLM_STUDENT_LORA_HOST_PATH=../four-leaf-AI/models/student-lora/adapter_student_llama
VLLM_PROFESSOR_LORA_HOST_PATH=../four-leaf-AI/models/professor-lora/adapter_professor_llama
VLLM_STUDENT_LORA_PATH=/models/student-lora
VLLM_PROFESSOR_LORA_PATH=/models/professor-lora
VLLM_MAX_LORA_RANK=64
VLLM_LORA_ADAPTERS={"student-lora":"student-lora","professor-lora":"professor-lora"}
HUGGING_FACE_HUB_TOKEN=replace_with_your_hugging_face_token

# ─────────────────────────────────────────
# AI 서비스 (Python / LangChain)
# ─────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...
# Claude judge key for evaluation (required only when running eval/evaluate.py)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-opus-20240229
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=four-leaf

# AI → Backend API 호출용
BACKEND_BASE_URL=http://backend:8080

# ─────────────────────────────────────────
# Frontend (React / Vite)
# ─────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_AI_BASE_URL=/ai

# ─────────────────────────────────────────
# AWS (ECR 이미지 주소 — CI/CD에서 자동 설정됨)
# ─────────────────────────────────────────
AWS_REGION=ap-northeast-2
FRONTEND_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-frontend:latest
BACKEND_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-backend:latest
AI_IMAGE=<account-id>.dkr.ecr.ap-northeast-2.amazonaws.com/four-leaf-ai:latest
